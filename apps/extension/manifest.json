    "https://*.bravofly.com/*",
    "https://*.mytrip.com/*",
    "https://*.flightnetwork.com/*",
    "https://*.cheapoair.com/*",
    "https://*.alternativeairlines.com/*",
    "https://*.booking.com/*",
    "https://*.agoda.com/*",
    "https://*.aircanada.com/*",
    "https://*.united.com/*",
