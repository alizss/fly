    "https://*.jal.co.jp/*",
    "https://*.koreanair.com/*",
    "https://*.airindia.com/*",
    "https://*.goindigo.in/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Air Travel Wallet"
  },
  "content_scripts": [
