    "https://*.flypgs.com/*",
    "https://*.wizzair.com/*",
    "https://*.ryanair.com/*",
    "https://*.easyjet.com/*",
    "https://*.vueling.com/*",
    "https://*.iberia.com/*",
    "https://*.flytap.com/*",
    "https://*.ita-airways.com/*",
    "https://*.lot.com/*",
    "https://*.finnair.com/*",
